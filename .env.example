# ---- Required (app raises RuntimeError on startup if unset) ----
SECRET_KEY=replace-with-a-long-random-string
ADMIN_PASSWORD=change-me
EXPERT_PASSWORD=change-me

# ---- Server ----
FLASK_DEBUG=false
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000

# ---- Judge LLM (needed to run new evaluations) ----
OPENROUTER_API_KEY=sk-or-v1-your-key
# MODEL_ID=google/gemini-3.5-flash
# JUDGE_TEMPERATURE=0.1
# JUDGE_MAX_TOKENS=2000
# JUDGE_REASONING_EFFORT=low
# JUDGE_MAX_WORKERS=8

# ---- Dataset (CSV/XLSX with columns: سوال, جواب مرجع, Agent Response) ----
# DATASET_PATH=uploads/sample_qa.csv

# ---- Optional: collect answers from a Dify chatbot ----
# DIFY_API_URL=https://your-dify-host/v1/chat-messages
# DIFY_API_KEY=
# DIFY_USER_ID=rag-evaluator
# COLLECT_TIMEOUT=300
# COLLECT_MAX_WORKERS=3
